digraph G { rankdir=LR; graph [fontname="Helvetica", fontsize=11, nodesep=0.5, ranksep=0.6, pad=0.3]; node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#5B6770"]; edge [fontname="Helvetica", fontsize=10, color="#5B6770"]; 
node [shape=plain, style="", fillcolor=""];
label="Database per service (from the migrations)"; labelloc=t; fontsize=13;
subgraph cluster_r { label="roadmap_db  (001_init.sql, 002_items_updated_at.sql)"; style=rounded; color="#0078D4";
users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#DCE6F2" port="t"><b>users</b></td></tr><tr><td align="left" port="id">id INT IDENTITY PK</td></tr><tr><td align="left">username NVARCHAR(30) UNIQUE (CI)</td></tr><tr><td align="left">password_hash NVARCHAR(255)</td></tr><tr><td align="left">is_admin BIT</td></tr><tr><td align="left">session_epoch INT</td></tr><tr><td align="left">path_field, path_level NVARCHAR</td></tr><tr><td align="left">github_username NVARCHAR(39)</td></tr><tr><td align="left">created_at DATETIME2</td></tr></table>>];
items [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#DCE6F2"><b>roadmap_items</b></td></tr><tr><td align="left" port="id">id INT IDENTITY PK</td></tr><tr><td align="left" port="u">user_id INT FK → users ON DELETE CASCADE</td></tr><tr><td align="left">title, type, platform, url NVARCHAR</td></tr><tr><td align="left">skill_tags, difficulty NVARCHAR</td></tr><tr><td align="left">priority INT, status NVARCHAR</td></tr><tr><td align="left">created_at DATETIME2</td></tr><tr><td align="left" bgcolor="#FFF8E1">updated_at DATETIME2 NOT NULL (002)</td></tr></table>>];
login [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#DCE6F2"><b>login_events</b></td></tr><tr><td align="left">id INT IDENTITY PK</td></tr><tr><td align="left" port="u">user_id INT FK → users CASCADE</td></tr><tr><td align="left">success BIT, ip NVARCHAR(64)</td></tr><tr><td align="left">created_at DATETIME2</td></tr></table>>];
ass [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#DCE6F2"><b>assessments</b></td></tr><tr><td align="left">id INT IDENTITY PK</td></tr><tr><td align="left" port="u">user_id INT FK → users CASCADE</td></tr><tr><td align="left">field, level NVARCHAR</td></tr><tr><td align="left">answers NVARCHAR(MAX) (JSON)</td></tr><tr><td align="left">score, max_score INT</td></tr><tr><td align="left">taken_at DATETIME2</td></tr></table>>];
rate [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#EEEEEE"><b>rate_events</b></td></tr><tr><td align="left">id PK, kind, [key]</td></tr><tr><td align="left">created_at FLOAT</td></tr></table>>];
rh [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#EEEEEE"><b>health_check</b> / <b>schema_migrations</b></td></tr></table>>];
items:u -> users:id; login:u -> users:id; ass:u -> users:id;
}
subgraph cluster_p { label="progress_db  (001_init.sql)"; style=rounded; color="#0078D4";
logs [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#DCE6F2"><b>progress_logs</b></td></tr><tr><td align="left">id INT IDENTITY PK</td></tr><tr><td align="left" port="u">user_id INT (plain ID)</td></tr><tr><td align="left" port="i">item_id INT (plain ID)</td></tr><tr><td align="left">checked_in_at DATETIME2</td></tr><tr><td align="left">completion_pct INT CHECK 0–100</td></tr><tr><td align="left">felt_difficulty NVARCHAR(10)</td></tr><tr><td align="left">notes NVARCHAR(2000)</td></tr><tr><td align="left">time_spent_mins INT</td></tr></table>>];
ph [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#EEEEEE"><b>health_check</b> / <b>schema_migrations</b></td></tr></table>>];
}
logs:i -> items:id [style=dashed, color="#C0392B", fontcolor="#C0392B", label="no FK: checked over HTTP", constraint=false];
}
